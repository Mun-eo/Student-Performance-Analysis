# ==============================================================
# 6. FINAL VISUALIZATIONS
# ==============================================================
# a. Correlation visualization of student smart phone usage and exam score
ggplot(analyzed_students_df, aes(x = `Smartphone Usage (hrs/day)`,
y = `Exam Score`)
) +
geom_point(color = "#6200EE", size = 2, alpha = 0.5) +
geom_smooth(method = "lm", color = "#03DAC5", se = TRUE, linewidth = 1.5) +
labs(
title = "Relationship between Student Smartphone Usage and Exam Scores",
subtitle = "Relationship found statistically significant (*p* < 0.05) but, the effect size is low (*r* = -0.07). There is no practical important relationship, significance susceptible large sample size instead of real world effects.",
x = "Smartphone Usage (Hours)",
y = "Exam Scores") +
theme_minimal() +
theme(
plot.title = element_text(face = "bold"),
plot.subtitle = element_textbox_simple(),
panel.grid.minor = element_blank(),
panel.grid.major = element_blank(),
axis.title = element_text(size = 11),
axis.line = element_line(),
axis.text = element_text(size = 10))
# ==============================================================
# 6. FINAL VISUALIZATIONS
